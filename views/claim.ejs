<%- layout('/layouts/boilerplate.ejs') %>
<body>
    <div class="container mt-4 mb-5">
        <div class="row justify-content-center">
            <div class="col-md-8 shadow-sm p-4 rounded border">
                <h2 class="mb-2 text-center fw-bold">Claim This Item</h2>
                <p class="text-muted text-center mb-4">Please provide details to verify your ownership.</p>
                
                <form action="/items/<%= item._id %>/claim" method="post" enctype="multipart/form-data">

                    <div class="form-floating mb-3">
                        <input type="text" class="form-control" id="name" placeholder="Your Name" name="claim[name]" required>
                        <label for="name">Full Name</label>
                    </div>

                    <div class="form-floating mb-3">
                        <input type="text" class="form-control" id="contact" placeholder="Phone or Email" name="claim[contact]" required>
                        <label for="contact">Contact Number (WhatsApp) / Email</label>
                    </div>

                    <% if(item.questions && item.questions.length > 0) { %>
                        <div class="border rounded p-3 mb-4 bg-light">
                            <h5 class="fw-bold mb-3"><i class="bi bi-patch-question"></i> Security Questions</h5>
                            <% item.questions.forEach((question, index) => { %>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Q<%= index + 1 %>: <%= question %></label>
                                    <input type="text" class="form-control" name="claim[answers][<%= index %>]" placeholder="Your answer..." required>
                                </div>
                            <% }) %>
                        </div>
                    <% } %>

                    <div class="form-floating mb-3">
                        <textarea class="form-control" name="claim[explaination]" placeholder="Explain how you lost it" id="explaination" style="height: 120px"></textarea>
                        <label for="explaination">Proof of Ownership / Explanation (Optional)</label>
                        <div class="form-text">Mention specific marks, stickers, or contents not visible in photos.</div>
                    </div>
                    
                    <% if(item.questions && item.questions.length < 0) { %>
                        <div class="mb-4">
                            <label for="claimImage" class="form-label fw-bold">Upload Supporting Image</label>
                            <input class="form-control" type="file" id="claimImage" name="claim[image]"> 
                            <div class="form-text">Upload a receipt or an old photo of the item if available.</div>
                        </div>
                    <% } %>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-success btn-lg btn-form">Submit Claim Request</button>
                        <a href="/items/<%= item._id %>" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</body>
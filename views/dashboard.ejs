<% layout('./layouts/boilerplate.ejs') %>
<body>
    <div class="container-fluid">
        <h1 class="ms-5 mt-4 fs-1 fw-bold">My Reported Items</h1>
        <div class="cards-holder">
            <% items.map((item,idx)=>{ %>
                <form action="/items/<%= item._id %>" method="get">
                    <button type="submit" class="card-click">
                    <div class="card">
                        <div>
                            <img src="<%= item.image %>" alt="<%= item.title %>">
                        </div>
                        <div class="card-txt">
                            <span class="card-title"><%= item.title %></span>
                            <br>
                            <span class="card-location">Found in <b><%= item.location %></b></span>
                            <br>
                            <span class="card-description"><%= item.description %></span>
                            <div class="card-btn mt-2">
                                <!-- <form action="#" method="get">
                                    <input type="submit" value="Claim" />
                                </form> -->
                            </div>
                        </div>
                    </div>
                    </button>
                </form>
            <% }) %>
        </div>
    </div>
</body>